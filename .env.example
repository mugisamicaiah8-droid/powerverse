# PowerVerse signaling server — environment configuration
# Copy to .env and load it with:  node --env-file=.env server.js   (Node 20+)
# Every value below is OPTIONAL; the defaults in server.js are what runs if you set nothing.

# Port to listen on. Most PaaS platforms inject this — do not hardcode it there.
PORT=3001

# Bind address. Keep 0.0.0.0 inside containers.
HOST=0.0.0.0

# Allowed app origin(s). Comma-separate several.
# SET THIS IN PRODUCTION — leave '*' only for local development.
# CORS_ORIGIN=https://app.example.com,http://localhost:8000
CORS_ORIGIN=*

# Simultaneous call participants per room (full-mesh limit).
MAX_CALL_PEERS=6

# Sockets allowed per room (call participants + people just viewing the sync).
MAX_ROOM_MEMBERS=16

# How long an empty room is remembered before being swept (ms). Default 30 min.
IDLE_ROOM_MS=1800000

# silent | info | debug   (debug logs every relayed SDP/ICE frame)
LOG_LEVEL=info
